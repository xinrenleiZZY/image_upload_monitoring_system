# ── 密钥与本地配置（绝不入库）──
.env
.env.local
.env.*.local

# ── 运行时数据：SQLite 生产库（含业务数据与消息内容）──
data/
*.db
*.db-wal
*.db-shm

# ── Python 缓存与构建产物 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
.venv/
venv/

# ── 日志 ──
*.log

# ── 编辑器 / 系统 ──
.idea/
.vscode/
.DS_Store
Thumbs.db
