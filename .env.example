# ===== 服务端口（7700-7799 区间，已确认本机未占用）=====
APP_HOST=0.0.0.0
APP_PORT=7701
TZ=Asia/Shanghai
LOG_LEVEL=INFO
# 启动后立刻调度一次（若距上次取数已达间隔则立即取数；重启不会重复取数）
POLL_ON_STARTUP=true
# 是否启用后台调度线程（关掉后只能靠手动/外部触发取数）
SCHEDULER_ENABLED=true
# 调度线程灵敏度（秒）
SCHEDULER_TICK_SECONDS=15

# ===== 数据库 =====
# 留空使用 data/monitor.db；Docker Compose 已映射到 /app/data/monitor.db
MONITOR_DB_PATH=

# ===== 开放 API 令牌（留空=不校验；建议第三方脚本与飞书群内保持一致）=====
API_TOKEN=

# ===== 对外访问地址（第三方脚本/接口文档示例用的地址）=====
PUBLIC_BASE_URL=http://192.168.0.193:7701

# ===== 领星接口（必须填 auth-token，浏览器登录后从开发者工具复制）=====
LINGXING_AUTH_TOKEN=
LINGXING_BASE_URL=https://gw.lingxingerp.com
LINGXING_PATH=/listing-publish-api/api/AmazonPublishQueue/list
LINGXING_COMPANY_ID=90136117059997696
LINGXING_ENV_KEY=huizhixin
LINGXING_UID=11054904
LINGXING_ZID=1
LINGXING_VERSION=3.9.1.3.0.114
LINGXING_LANGUAGE=zh
LINGXING_ORIGIN=https://huizhixin.lingxing.com
LINGXING_PLATFORM=1
LINGXING_CLIENT_TYPE=web
LINGXING_REQUEST_SOURCE=erp
# 容器内访问领星需要走本机代理时填写（留空=直连）
LINGXING_PROXY=http://host.docker.internal:7897
LINGXING_TIMEOUT=30

# ===== 取数参数 =====
QUERY_COUNTRY_ID=1
QUERY_WINDOW_DAYS=45
QUERY_PAGE_SIZE=100
QUERY_MAX_PAGES=50
QUERY_IS_ARCHIVE=0

# ===== 兜底数据源（自建领星 API 站）：领星直连失败时自动改从这里取数 =====
FALLBACK_ENABLED=true
FALLBACK_BASE_URL=http://192.168.40.194:7788
FALLBACK_PATH=/api/proxy
FALLBACK_USER_ID=
FALLBACK_USER_TOKEN=
FALLBACK_ACCOUNT=xiazhanggui
FALLBACK_API_NAME=Amazon刊登队列列表（AmazonPublishQueue/list）
FALLBACK_API_ID=4833dfb271cb
FALLBACK_AUTO_PAGINATION=true
FALLBACK_ONLY_ON_AUTH=false
FALLBACK_TIMEOUT=120
# 走兜底时是否在告警群发提示（默认 false：不发消息，只在页面显示数据来源）
NOTIFY_FALLBACK=false

# ===== 调度与跟进 =====
POLL_INTERVAL_MINUTES=60
PROCESSING_POLL_INTERVAL_MINUTES=10
FOLLOW_INTERVAL_MINUTES=10
FOLLOW_ROUND_MINUTES=30
FOLLOW_MAX_ATTEMPTS=5
FOLLOW_SESSION_MAX_HOURS=6
AUTO_FOLLOW_PROCESSING=true
AUTO_FOLLOW_FAILED=false
AUTO_FOLLOW_NOTIFY=true
AUTO_FOLLOW_RECENT_HOURS=72
AUTO_FOLLOW_COOLDOWN_HOURS=6
AUTO_FOLLOW_MAX_SESSIONS=200
# 失败自动跟进起始时间：只自动跟进该时间之后完成/变化的失败（留空=不限制）
FOLLOW_START_AT=

# ===== 状态判定 =====
STATUS_SUCCESS_VALUE=3
STATUS_FAILED_VALUE=4

# ===== 飞书通知（稍后补 app_id/app_secret/chat_id/open_id）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_RECEIVER_OPEN_ID=
# 二号虾掌柜的 open_id（配置后消息里是真正的 @ 提醒，留空则纯文本 @二号虾掌柜）
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_NAME=二号虾掌柜
# 也可以改用群自定义机器人 Webhook（与 app 二选一）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ===== 消息开关 =====
NOTIFY_RETRY=true
NOTIFY_SUCCESS=true
NOTIFY_FINAL_FAILURE=true
NOTIFY_POLL_ERROR=true
POLL_ERROR_NOTIFY_MINUTES=60
# 取数失败（如 token 过期）的告警只发这个群；留空=发所有群
POLL_ERROR_CHAT_ID=oc_f57489fe7119d84bcb45567432bb8ae7
MESSAGE_DEDUPE_SECONDS=30
